{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/handoff/**/*.json)",
      "Read(**/*.dump)",
      "Read(**/*.db)",
      "Read(**/*.sqlite)",
      "Read(**/audit-log.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(supabase db reset --linked*)",
      "Bash(rm -rf /*)"
    ]
  }
}
