# ─── Supabase (PÚBLICAS: viajan al cliente; la RLS pone el alcance) ──────────
# Dónde: Supabase → Project Settings → API. En EAS: `eas env:create --scope project`.
# Nunca pongas aquí ni en eas.json/app.config.ts los valores reales.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ─── Identidad de la app (opcional; app.config.ts tiene defaults) ─────────────
APP_NAME=App
APP_SLUG=app
APP_SCHEME=app
APP_BUNDLE_ID=com.mindscopeanalytics.app

# ─── PROHIBIDO en una app Expo ───────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY=   ← jamás en cliente. Vive solo en Edge Functions/servidor.
