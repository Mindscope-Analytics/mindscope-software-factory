{
  "name": "mindscope-software-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Plantilla de gobernanza de Mindscope Analytics: reglas para Claude Code, compuertas locales, CI y presets.",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "prepare": "bash scripts/setup-hooks.sh",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm run test:guard && pnpm -r --if-present run test",
    "test:guard": "bash scripts/test-guard.sh",
    "lint:workflows": "actionlint",
    "check:rls": "bash scripts/check-rls.sh",
    "check:secrets": "gitleaks git --redact --no-banner .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db"
  }
}
