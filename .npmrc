# nosemgrep: package_managers.npm.npm-missing-minimum-release-age.npm-missing-minimum-release-age
# Metro (Expo / React Native) necesita node_modules plano.
node-linker=hoisted
# pnpm respeta "engines" y falla si la versión de Node no coincide con .nvmrc.
engine-strict=true
# La política de cadena de suministro (minimumReleaseAge, blockExoticSubdeps) vive en
# pnpm-workspace.yaml; ver docs/adr/0004-politica-cadena-de-suministro.md.
